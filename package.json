{
  "name": "echolingo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/shared",
    "src/web",
    "src/api"
  ],
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "build": "npm run build --workspaces --if-present",
    "predev": "npm run build --workspace @echolingo/shared",
    "dev": "concurrently --kill-others --names azurite,shared,api,web --prefix-colors gray,magenta,blue,green \"npm:azurite\" \"npm:dev:shared\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:shared": "npm run dev --workspace @echolingo/shared",
    "dev:web": "npm run dev --workspace @echolingo/web",
    "dev:api": "npm run start --workspace @echolingo/api",
    "azurite": "azurite --location ./azurite-data --silent --skipApiVersionCheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.60.0",
    "azurite": "^3.32.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  }
}
