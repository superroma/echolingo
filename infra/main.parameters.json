{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "domainName": { "value": "${DOMAIN_NAME=echolingo.audio}" },
    "dnsZoneName": { "value": "${DNS_ZONE_NAME=echolingo.audio}" },
    "dnsZoneResourceGroupName": { "value": "${DNS_ZONE_RESOURCE_GROUP=}" },
    "openAiLocation": { "value": "${AZURE_OPENAI_LOCATION=swedencentral}" },
    "ttsLocation": { "value": "${AZURE_OPENAI_TTS_LOCATION=eastus2}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE=User}" },
    "llmModelName": { "value": "${LLM_MODEL_NAME=gpt-5.4-mini}" },
    "llmModelVersion": { "value": "${LLM_MODEL_VERSION=2026-03-17}" },
    "ttsModelName": { "value": "${TTS_MODEL_NAME=gpt-4o-mini-tts}" },
    "ttsModelVersion": { "value": "${TTS_MODEL_VERSION=2025-12-15}" },
    "deploymentQuotaTpm": { "value": "${DEPLOYMENT_QUOTA_TPM=150}" },
    "ttsQuotaTpm": { "value": "${TTS_QUOTA_TPM=50}" },
    "speechLocation": { "value": "${AZURE_SPEECH_LOCATION=westeurope}" },
    "ttsEngine": { "value": "${TTS_ENGINE_CHOICE=azurespeech}" }
  }
}
