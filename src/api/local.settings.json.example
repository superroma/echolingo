{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "FUNCTIONS_EXTENSION_VERSION": "~4",
    "AzureWebJobsFeatureFlags": "EnableWorkerIndexing",

    "AzureWebJobsStorage": "UseDevelopmentStorage=true",

    "_comment_local_storage": "For local dev against Azurite; in production these are unset and the app uses STORAGE_BLOB_ENDPOINT + managed identity.",

    "LLM_ENGINE": "openai",
    "TTS_ENGINE": "openai",

    "AZURE_OPENAI_ENDPOINT": "https://aoai-echolingo-prod.openai.azure.com",
    "AZURE_OPENAI_LLM_DEPLOYMENT": "gpt-5.4-mini",
    "AZURE_OPENAI_TTS_DEPLOYMENT": "tts",
    "AZURE_OPENAI_API_VERSION": "2024-10-21",

    "_comment_local_openai_alternative": "To use direct OpenAI instead of Azure OpenAI, set OPENAI_API_KEY (and unset AZURE_OPENAI_ENDPOINT).",

    "RATE_LIMIT_PER_DAY": "20",
    "APPLICATIONINSIGHTS_CONNECTION_STRING": ""
  }
}
